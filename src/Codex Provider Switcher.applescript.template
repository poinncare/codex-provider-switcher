property helper : "__HELPER_PATH__"

on splitText(theText, theDelimiter)
    set oldDelimiters to AppleScript's text item delimiters
    set AppleScript's text item delimiters to theDelimiter
    set pieces to text items of theText
    set AppleScript's text item delimiters to oldDelimiters
    return pieces
end splitText

on chooseCodexAccount()
    set rawRows to paragraphs of (do shell script helper & " prepare-accounts")
    set displayRows to {}
    repeat with rawRow in rawRows
        set fields to my splitText(rawRow as text, tab)
        if (count of fields) ≥ 2 then set end of displayRows to item 2 of fields
    end repeat
    if (count of displayRows) is less than 2 then error "Не удалось найти авторизованные подписки Codex."
    set picked to choose from list displayRows with title "Codex" with prompt "Выберите аккаунт:" OK button name "Войти" cancel button name "Отмена"
    if picked is false then return
    set pickedLabel to item 1 of picked
    repeat with rawRow in rawRows
        set fields to my splitText(rawRow as text, tab)
        if (count of fields) ≥ 2 and (item 2 of fields) is pickedLabel then
            do shell script helper & " switch-account " & quoted form of (item 1 of fields)
            exit repeat
        end if
    end repeat
end chooseCodexAccount

on chooseModel(providerKey)
    set rawRows to paragraphs of (do shell script helper & " list-models " & quoted form of providerKey)
    set displayRows to {}
    set keyRows to {}
    repeat with rawRow in rawRows
        set fields to my splitText(rawRow as text, tab)
        if (count of fields) ≥ 2 then
            set end of displayRows to item 2 of fields
            set end of keyRows to item 1 of fields
        end if
    end repeat
    if (count of displayRows) is 0 then error "Для выбранного провайдера не найдены модели. Убедитесь, что gateway запущен и доступен."
    set picked to choose from list displayRows with title "Codex" with prompt "Выберите модель:" OK button name "Выбрать" cancel button name "Отмена"
    if picked is false then return
    set pickedLabel to item 1 of picked
    repeat with i from 1 to count of displayRows
        if item i of displayRows is pickedLabel then
            do shell script helper & " switch-provider " & quoted form of providerKey & " " & quoted form of (item i of keyRows)
            exit repeat
        end if
    end repeat
end chooseModel

on chooseProvider()
    set rawRows to paragraphs of (do shell script helper & " list-providers")
    set displayRows to {}
    repeat with rawRow in rawRows
        set fields to my splitText(rawRow as text, tab)
        if (count of fields) ≥ 2 then set end of displayRows to item 2 of fields
    end repeat
    if (count of displayRows) is 0 then error "Провайдеры не найдены."
    set picked to choose from list displayRows with title "Codex" with prompt "Что переключить:" default items {item 1 of displayRows} OK button name "Выбрать" cancel button name "Отмена"
    if picked is false then return
    set pickedLabel to item 1 of picked
    repeat with rawRow in rawRows
        set fields to my splitText(rawRow as text, tab)
        if (count of fields) ≥ 2 and (item 2 of fields) is pickedLabel then
            set providerKey to item 1 of fields
            if providerKey is "openai" then
                my chooseCodexAccount()
            else
                my chooseModel(providerKey)
            end if
            exit repeat
        end if
    end repeat
end chooseProvider

on run
    try
        my chooseProvider()
    on error errorMessage
        display dialog errorMessage with title "Codex — ошибка" buttons {"OK"} default button "OK"
    end try
end run
